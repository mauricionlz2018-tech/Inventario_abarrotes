<%- include('partials/header', { titulo: 'Proveedores' }) %>
<section class="section-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <span class="section-kicker">Compras</span>
    <h1 class="h2 mb-1">Proveedores</h1>
  </div>
  <a href="/proveedores/nuevo" class="btn btn-brand">Nuevo proveedor</a>
</section>

<div class="table-card table-responsive">
  <table class="table align-middle mb-0 inventory-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Empresa</th>
        <th>Teléfono</th>
        <th>Correo</th>
        <th>Dirección</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (proveedores.length === 0) { %>
        <tr><td colspan="6" class="text-center py-5 text-muted">No hay proveedores registrados.</td></tr>
      <% } %>
      <% proveedores.forEach(p => { %>
        <tr>
          <td><%= p.id_proveedor %></td>
          <td><%= p.nombre_empresa %></td>
          <td><%= p.telefono %></td>
          <td><%= p.correo || 'Sin correo' %></td>
          <td><%= p.direccion || 'Sin dirección' %></td>
          <td>
            <div class="d-flex justify-content-end flex-wrap gap-2">
              <a href="/proveedores/editar/<%= p.id_proveedor %>" class="btn btn-sm btn-outline-brand">Editar</a>
              <form action="/proveedores/eliminar/<%= p.id_proveedor %>" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar este proveedor?')">Eliminar</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
