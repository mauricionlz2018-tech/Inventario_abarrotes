<%- include('partials/header', { titulo: 'Usuarios' }) %>
<section class="section-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <span class="section-kicker">Seguridad</span>
    <h1 class="h2 mb-1">Usuarios</h1>
  </div>
  <a href="/usuarios/nuevo" class="btn btn-brand">Nuevo usuario</a>
</section>

<div class="table-card table-responsive">
  <table class="table align-middle mb-0 inventory-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Usuario</th>
        <th>Rol</th>
        <th>Estado</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (usuarios.length === 0) { %>
        <tr><td colspan="6" class="text-center py-5 text-muted">No hay usuarios registrados.</td></tr>
      <% } %>
      <% usuarios.forEach(u => { %>
        <tr>
          <td><%= u.id_usuario %></td>
          <td><%= u.nombre %></td>
          <td><%= u.usuario %></td>
          <td><%= u.rol %></td>
          <td><%= u.activo ? 'Activo' : 'Inactivo' %></td>
          <td>
            <div class="d-flex justify-content-end flex-wrap gap-2">
              <a href="/usuarios/editar/<%= u.id_usuario %>" class="btn btn-sm btn-outline-brand">Editar</a>
              <form action="/usuarios/eliminar/<%= u.id_usuario %>" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar este usuario?')">Eliminar</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
